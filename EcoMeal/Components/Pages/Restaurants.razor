@page "/restaurants"
@attribute [StreamRendering]

<PageTitle>Restaurants</PageTitle>

<h1>Restaurants</h1>

<p>This component demonstrates showing data.</p>

@if (restaurants == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        @foreach (var r in restaurants)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <img src="@r.ImageUrl" width="140"  /img>
                        <h5 class="card-title">@r.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@r.Location</h6>
                        <span class="badge bg-success">Rating: @r.Rating</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private Restaurant[]? restaurants;

    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        await Task.Delay(500);

        var names = new[] { "McDonald's", "KFC", "Bulldog Burger"};
        var locations = new[] { "" };
        restaurants = Enumerable.Range(1, 3).Select(index => new Restaurant
        {
            Name = names[Random.Shared.Next(names.Length)],
            Location = locations[Random.Shared.Next(locations.Length)],
            ImageUrl = "https://img.freepik.com/premium-vector/restaurant-logo-design_617585-671.jpg",
            Rating = Random.Shared.Next(1, 5),

        }).ToArray();
    }

    private class Restaurant
    {
        public String Name { get; set; }
        public String Location { get; set; }
        public String ImageUrl { get; set; }
        public int Rating{ get; set; }
    }
}
