@page "/shop"
@layout CustomerLayout
@rendermode InteractiveServer
@using EcoMeal.Controllers
@using EcoMeal.Entities
@using EcoMeal.Entities.Enums
@using EcoMeal.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject PackageController PackageController
@inject IOrderService OrderService
@attribute [Authorize(Roles = "Customer")]


<div class="mb-4">
    <div class="text-muted small font-monospace">Descoperă</div>
    <h1 class="page-title mb-0" style="font-size:1.9rem;">Salvează mâncare bună lângă tine</h1>
    <p class="text-muted mt-1">Pachete-surpriză de la afaceri locale, la preț redus.</p>
</div>

@if (message is not null)
{
    <div class="alert @(isError ? "alert-warning" : "alert-success") py-2">@message</div>
}

@if (packages is null)
{
    <p class="text-muted">Se încarcă…</p>
}
else
{
    <div class="eco-toolbar">
        <div class="eco-search">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
            <input class="form-control" placeholder="Caută pachete sau afaceri…" @bind="searchTerm" @bind:event="oninput" />
        </div>

        <select class="form-select eco-w" @bind="selectedType">
            <option value="">Toate tipurile</option>
            @foreach (var type in Enum.GetValues<PackageTypeEnum>())
            {
                <option value="@type">@type</option>
            }
        </select>

        <select class="form-select eco-w" @bind="selectedBusinessId">
            <option value="">Toate afacerile</option>
            @foreach (var business in businesses)
            {
                <option value="@business.Id">@business.Name</option>
            }
        </select>

        <select class="form-select eco-w" @bind="sortOption">
            <option value="">Sortează</option>
            <option value="price_asc">Preț crescător</option>
            <option value="price_desc">Preț descrescător</option>
            <option value="name_asc">Nume (A→Z)</option>
            <option value="name_desc">Nume (Z→A)</option>
        </select>
    </div>

    <div class="eco-pkg-grid">
        @foreach (var package in sortedPackages)
        {
            <div class="eco-pkg">
                <div class="eco-pkg-img" style="background-image:url('@package.ImageUrl')">
                    <span class="eco-pkg-left">@package.Quantity rămase</span>
                </div>
                <div class="eco-pkg-body">
                    <div class="eco-pkg-biz">
                        <img class="eco-pkg-logo" src="@package.Business?.ImageUrl" alt="" />
                        <div>
                            <div class="eco-pkg-bizname">@package.Business?.Name</div>
                            <div class="eco-pkg-bizmeta">@package.Business?.BusinessType?.Name</div>
                        </div>
                    </div>
                    <div class="eco-pkg-name">@package.Name</div>
                    <div class="eco-pkg-row">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                        Ridicare @package.PickupStart.ToString("dd MMM, HH:mm") – @package.PickupEnd.ToString("HH:mm")
                    </div>
                    <div class="eco-pkg-foot">
                        <div class="d-flex align-items-center gap-2">
                            <input type="number" class="form-control form-control-sm" style="width:70px;"
                                   min="1" max="@package.Quantity"
                                   @bind="quantities[package.Id]" />
                            <button class="btn btn-primary btn-sm"
                                    @onclick="() => AddToCart(package)"
                                    disabled="@(package.Quantity == 0)">
                                Rezervă
                            </button>
                        </div>
                        <div class="eco-pkg-price">@package.Price.ToString("0.00") lei</div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!sortedPackages.Any())
    {
        <div class="p-4 text-center text-muted"><em>Niciun pachet disponibil momentan.</em></div>
    }
}

@code {
    private List<Package>? packages;
    private Dictionary<Guid, int> quantities = new();
    private string searchTerm;
    private PackageTypeEnum? selectedType;
    private Guid? selectedBusinessId;
    private string sortOption;

    private string? message;
    private bool isError;

    // afacerile distincte din pachetele încărcate (pentru dropdown)
    private IEnumerable<Business> businesses =>
    packages is null
        ? Enumerable.Empty<Business>()
        : packages
            .Where(p => p.Business is not null)
            .Select(p => p.Business!)
            .GroupBy(b => b.Id)
            .Select(g => g.First())
            .OrderBy(b => b.Name);

    private IEnumerable<Package> filteredPackages =>
        packages is null
            ? Enumerable.Empty<Package>()
            : packages.Where(p =>
                (string.IsNullOrWhiteSpace(searchTerm) ||
                 (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (p.Business?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                &&
                (selectedType is null || p.PackageTypeId == selectedType)
                &&
                (selectedBusinessId is null || p.BusinessId == selectedBusinessId));

    private IEnumerable<Package> sortedPackages =>
        sortOption switch
        {
            "price_asc" => filteredPackages.OrderBy(p => p.Price),
            "price_desc" => filteredPackages.OrderByDescending(p => p.Price),
            "name_asc" => filteredPackages.OrderBy(p => p.Name),
            "name_desc" => filteredPackages.OrderByDescending(p => p.Name),
            _ => filteredPackages
        };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        packages = (await PackageController.GetAll()).Value;

        if (packages is not null)
        {
            foreach (var package in packages)
                quantities[package.Id] = 1;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        if (AuthState is null)
            return null;

        var state = await AuthState;
        var user = state.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
            return null;

        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task AddToCart(Package package)
    {
        var userId = await GetUserIdAsync();
        if (userId is null)
        {
            message = "Trebuie să fii autentificat ca să rezervi.";
            isError = true;
            return;
        }

        var quantity = quantities.TryGetValue(package.Id, out var q) ? q : 1;

        try
        {
            await OrderService.AddToCartAsync(userId, package.Id, quantity);
            message = $"{package.Name} (x{quantity}) a fost adăugat în coș.";
            isError = false;
        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
            isError = true;
        }
    }
}