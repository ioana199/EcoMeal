@page "/shop"
@using EcoMeal.Controllers
@using EcoMeal.Entities
@inject PackageController PackageController

<h3 class="mb-4">Pachete disponibile</h3>

@if (packages is null)
{
    <p>Loading...</p>
}
else if (!packages.Any())
{
    <p><em>Nu există pachete disponibile momentan.</em></p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var package in packages)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(package.ImageUrl))
                    {
                        <img src="@package.ImageUrl" class="card-img-top" alt="@package.Name"
                             style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height: 180px;">
                            <span class="text-muted">Fără imagine</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@package.Name</h5>
                            <span class="badge bg-success">@package.PackageType?.Name</span>
                        </div>

                        @if (package.Business is not null)
                        {
                            <h6 class="card-subtitle text-muted mb-2">@package.Business.Name</h6>
                        }

                        <p class="card-text">@package.Description</p>

                        <ul class="list-unstyled small text-muted mb-3">
                            <li>Ridicare: @package.PickupStart.ToString("dd.MM.yyyy HH:mm") – @package.PickupEnd.ToString("dd.MM.yyyy HH:mm")</li>
                            <li>Cantitate disponibilă: @package.Quantity</li>
                        </ul>

                        <div class="mt-auto">
                            <span class="fs-5 fw-bold text-success">@package.Price.ToString("0.00") lei</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Package>? packages;

    protected override async Task OnInitializedAsync()
    {
        packages = (await PackageController.GetAll()).Value;
    }
}