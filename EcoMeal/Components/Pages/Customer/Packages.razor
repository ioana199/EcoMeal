@page "/shop"
@rendermode InteractiveServer
@using EcoMeal.Controllers
@using EcoMeal.Entities
@using EcoMeal.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject PackageController PackageController
@inject IOrderService OrderService

<h3 class="mb-4">Pachete disponibile</h3>

@if (message is not null)
{
    <div class="alert @(isError ? "alert-warning" : "alert-success") py-2">@message</div>
}

@if (packages is null)
{
    <p>Loading...</p>
}
else if (!packages.Any())
{
    <p><em>Nu există pachete disponibile momentan.</em></p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var package in packages)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(package.ImageUrl))
                    {
                        <img src="@package.ImageUrl" class="card-img-top" alt="@package.Name"
                             style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height: 180px;">
                            <span class="text-muted">Fără imagine</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@package.Name</h5>
                            <span class="badge bg-success">@package.PackageType?.Name</span>
                        </div>

                        @if (package.Business is not null)
                        {
                            <h6 class="card-subtitle text-muted mb-2">@package.Business.Name</h6>
                        }

                        <p class="card-text">@package.Description</p>

                        <ul class="list-unstyled small text-muted mb-3">
                            <li>Ridicare: @package.PickupStart.ToString("dd.MM.yyyy HH:mm") – @package.PickupEnd.ToString("dd.MM.yyyy HH:mm")</li>
                            <li>Cantitate disponibilă: @package.Quantity</li>
                        </ul>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fs-5 fw-bold text-success">@package.Price.ToString("0.00") lei</span>

                                <input type="number" class="form-control form-control-sm" style="width: 80px;"
                                       min="1" max="@package.Quantity"
                                       @bind="quantities[package.Id]" />
                            </div>

                            <button class="btn btn-success btn-sm w-100"
                                    @onclick="() => AddToCart(package)"
                                    disabled="@(package.Quantity == 0)">
                                Add to cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Package>? packages;
    private Dictionary<Guid, int> quantities = new();

    private string? message;
    private bool isError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        packages = (await PackageController.GetAll()).Value;

        if (packages is not null)
        {
            foreach (var package in packages)
                quantities[package.Id] = 1;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        if (AuthState is null)
            return null;

        var state = await AuthState;
        var user = state.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
            return null;

        return user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task AddToCart(Package package)
    {
        var userId = await GetUserIdAsync();
        if (userId is null)
        {
            message = "Trebuie să fii autentificat ca să adaugi în coș.";
            isError = true;
            return;
        }

        var quantity = quantities.TryGetValue(package.Id, out var q) ? q : 1;

        try
        {
            await OrderService.AddToCartAsync(userId, package.Id, quantity);
            message = $"{package.Name} (x{quantity}) a fost adăugat în coș.";
            isError = false;
        }
        catch (InvalidOperationException ex)
        {
            message = ex.Message;
            isError = true;
        }
    }
}