@page "/packages/create"
@page "/packages/update/{PackageId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,BusinessManager")]
@using EcoMeal.Constants
@using EcoMeal.Entities.Enums
@using EcoMeal.Entities
@using EcoMeal.Controllers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject BusinessController BusinessController
@inject PackageController PackageController
@inject NavigationManager NavigationManager

<div class="mb-4">
    <div class="text-muted small font-monospace">Gestiune / Pachete / @(PackageId is null ? "Nou" : "Editare")</div>
    <h1 class="page-title mb-0" style="font-size:1.7rem;">
        @(PackageId is null ? "Pachet nou" : "Editează pachetul")
    </h1>
</div>

@if (error is not null)
{
    <div class="alert alert-warning py-2" style="max-width:720px;">@error</div>
}

<div class="eco-tablecard" style="max-width:720px; padding:1.6rem;">
    <EditForm Model="@model" FormName="createPackageForm">
        <div class="mb-3">
            <label for="name" class="form-label">Nume</label>
            <InputText id="name" class="form-control" @bind-Value="model.Name" placeholder="Ex. Surpriză de patiserie" />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Descriere</label>
            <InputText id="description" class="form-control" @bind-Value="model.Description" />
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="packageType" class="form-label">Tip</label>
                <InputSelect id="packageType" class="form-select" @bind-Value="model.PackageType">
                    @foreach (var type in Enum.GetValues<PackageTypeEnum>())
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
            </div>

            @if (isAdmin)
            {
                <div class="col-md-6">
                    <label for="BusinessId" class="form-label">Afacere</label>
                    <InputSelect id="BusinessId" class="form-select" @bind-Value="model.BusinessId" TValue="Guid">
                        @foreach (var business in businesses)
                        {
                            <option value="@business.Id.ToString()">@business.Name</option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="col-md-6">
                <label for="pickupStart" class="form-label">Ridicare — de la</label>
                <InputDate id="pickupStart" class="form-control" @bind-Value="model.PickupStart" />
            </div>
            <div class="col-md-6">
                <label for="pickupEnd" class="form-label">Ridicare — până la</label>
                <InputDate id="pickupEnd" class="form-control" @bind-Value="model.PickupEnd" />
            </div>

            <div class="col-md-6">
                <label for="quantity" class="form-label">Cantitate</label>
                <InputNumber id="quantity" class="form-control" @bind-Value="model.Quantity" />
            </div>
            <div class="col-md-6">
                <label for="Price" class="form-label">Preț (lei)</label>
                <InputNumber id="Price" class="form-control" @bind-Value="model.Price" />
            </div>

            <div class="col-12">
                <label for="imageUrl" class="form-label">Imagine (URL)</label>
                <InputText id="imageUrl" class="form-control" @bind-Value="model.ImageUrl" placeholder="https://…" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary" @onclick="Submit">
                @(PackageId is null ? "Salvează pachetul" : "Salvează modificările")
            </button>
            <a href="packages" class="btn btn-outline-secondary">Anulează</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public Guid? PackageId { get; set; }

    private PackageFormModel model = new PackageFormModel();
    private List<Business> businesses = new List<Business>();
    private string? error;

    private string? userId;
    private bool isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole(AppRoles.Admin);
        }

        // doar adminul alege business-ul, deci doar lui îi trebuie lista
        if (isAdmin)
        {
            businesses = (await BusinessController.GetAll()).Value ?? new List<Business>();
            if (businesses.Any())
                model.BusinessId = businesses.First().Id;
        }

        if (PackageId is null)
            return;

        var package = (await PackageController.GetById(PackageId)).Value;
        if (package is null)
            return;

        model.Name = package.Name;
        model.Description = package.Description;
        model.PackageType = package.PackageTypeId;
        model.PickupStart = package.PickupStart;
        model.PickupEnd = package.PickupEnd;
        model.Quantity = package.Quantity;
        model.Price = package.Price;
        model.ImageUrl = package.ImageUrl;
        model.BusinessId = package.BusinessId;
    }

    private async Task Submit()
    {
        if (userId is null)
            return;

        var package = new Package
        {
            Name = model.Name,
            Description = model.Description,
            PackageTypeId = (PackageTypeEnum)model.PackageType,
            PickupStart = model.PickupStart,
            PickupEnd = model.PickupEnd,
            Quantity = model.Quantity,
            Price = model.Price,
            ImageUrl = model.ImageUrl,
            BusinessId = model.BusinessId   // pentru manager e ignorat, service-ul îl forțează
        };

        try
        {
            if (PackageId is null)
                await PackageController.Add(package, userId, isAdmin);
            else
                await PackageController.Update(package, PackageId.Value, userId, isAdmin);

            NavigationManager.NavigateTo("/packages");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private class PackageFormModel
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public PackageTypeEnum PackageType { get; set; }
        public DateTime PickupStart { get; set; } = DateTime.Now;
        public DateTime PickupEnd { get; set; } = DateTime.Now.AddDays(1);
        public int Quantity { get; set; }
        public float Price { get; set; }
        public string ImageUrl { get; set; }
        public Guid BusinessId { get; set; }
    }
}
