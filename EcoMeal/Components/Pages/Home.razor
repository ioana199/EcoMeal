@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <h1>Salut, @context.User.Identity?.Name</h1>
        <p>Bine ai revenit pe EcoMeal!</p>
    </Authorized>
    <NotAuthorized>
        <h1>Bine ai venit pe EcoMeal</h1>
        <p>Autentifică-te ca să începi să comanzi</p>
    </NotAuthorized>
</AuthorizeView>