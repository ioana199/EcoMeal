@page "/packages"
@rendermode InteractiveServer
@using EcoMeal.Controllers
@using EcoMeal.Entities
@using EcoMeal.Entities.Enums
@inject PackageController PackageController

@if (packages is null)
{
    <p class="text-muted">Se încarcă…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small font-monospace">Gestiune / Pachete</div>
            <h1 class="page-title mb-0" style="font-size:1.7rem;">Pachete</h1>
        </div>
        <a href="packages/create" class="btn btn-primary">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            Pachet nou
        </a>
    </div>

    @* ---- TOOLBAR ---- *@
    <div class="eco-toolbar">
        <div class="eco-search">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4-4" /></svg>
            <input class="form-control"
                   placeholder="Caută după nume, adresă sau descriere..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <select class="form-select eco-w" @bind="selectedType">
            <option value="">Toate tipurile</option>
            @foreach (var type in Enum.GetValues<PackageTypeEnum>())
            {
                <option value="@type">@type</option>
            }
        </select>

        <select class="form-select eco-w" @bind="sortOption">
            <option value="">Fără sortare</option>
            <option value="name_asc">Nume (A→Z)</option>
            <option value="name_desc">Nume (Z→A)</option>
            <option value="price_asc">Preț (mic→mare)</option>
            <option value="price_desc">Preț (mare→mic)</option>
            <option value="quantity_asc">Cantitate (mic→mare)</option>
            <option value="quantity_desc">Cantitate (mare→mic)</option>
            <option value="type_asc">Tip (A→Z)</option>
            <option value="type_desc">Tip (Z→A)</option>
        </select>
    </div>

    @* ---- TABEL ---- *@
    <div class="eco-tablecard">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Imagine</th>
                    <th>Nume</th>
                    <th>Descriere</th>
                    <th>Tip</th>
                    <th>Ridicare</th>
                    <th>Cantitate</th>
                    <th>Preț</th>
                    <th class="text-end">Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var package in sortedPackages)
                {
                    <tr>
                        <td><img class="eco-thumb" src="@package.ImageUrl" alt="@package.Name" /></td>
                        <td><div class="eco-tname">@package.Name</div></td>
                        <td><div class="eco-tdesc">@package.Description</div></td>
                        <td>
                            <span class="badge-eco @(((int)package.PackageTypeId % 4) switch { 0 => "badge-green", 1 => "badge-warm", 2 => "badge-amber", _ => "badge-neutral" })">
                                @package.PackageType.Name
                            </span>
                        </td>
                        <td class="text-muted" style="white-space:nowrap;">
                            @package.PickupStart.ToString("dd MMM, HH:mm")<br />
                            <span class="small">→ @package.PickupEnd.ToString("dd MMM, HH:mm")</span>
                        </td>
                        <td>@package.Quantity</td>
                        <td><strong style="color:var(--eco-green-700);">@package.Price.ToString("0.00") lei</strong></td>
                        <td>
                            <div class="eco-tactions">
                                <a href="@($"packages/update/{package.Id}")" class="btn btn-outline-secondary btn-icon" title="Editează">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                </a>
                                <button class="btn btn-danger btn-icon" title="Șterge" @onclick="() => ShowDeleteConfirmation(package)">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ---- MODAL confirmare ștergere ---- *@
@if (packageToDelete is not null)
{
    <div class="modal fade show d-block eco-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="eco-modal-ic">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" /><path d="M10 11v6M14 11v6" /></svg>
                </div>
                <h5 class="modal-title">Ștergi acest pachet?</h5>
                <p class="modal-text">„<strong>@packageToDelete.Name</strong>" va fi eliminat definitiv. Această acțiune nu poate fi anulată.</p>
                <div class="modal-actions">
                    <button class="btn btn-outline-secondary" @onclick="CancelDelete">Nu</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Da, șterge</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}


@code {
    private List<Package>? packages;
    private Package? packageToDelete;
    private string searchTerm;
    private PackageTypeEnum? selectedType;
    private string sortOption;
    private Business? selectedBusiness;

    protected override async Task OnInitializedAsync()
    {
        packages = (await PackageController.GetAll()).Value;
    }

    private void ShowDeleteConfirmation(Package package)
    {
        packageToDelete = package;
    }

    private void CancelDelete()
    {
        packageToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (packageToDelete is null)
            return;

        await PackageController.Delete(packageToDelete.Id);
        await OnInitializedAsync();
        packageToDelete = null;
    }

    private IEnumerable<Package> filteredPackages =>
       packages is null
           ? Enumerable.Empty<Package>()
           : packages.Where(p =>
               (string.IsNullOrWhiteSpace(searchTerm) ||
                (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
               &&
               (selectedType is null || p.PackageTypeId == selectedType));

    private IEnumerable<Package> sortedPackages =>
       sortOption switch
       {
           "name_asc" => filteredPackages.OrderBy(p => p.Name),
           "name_desc" => filteredPackages.OrderByDescending(p => p.Name),
           "price_asc" => filteredPackages.OrderBy(p => p.Price),
           "price_desc" => filteredPackages.OrderByDescending(p => p.Price),
           "quantity_asc" => filteredPackages.OrderBy(p => p.Quantity),
           "quantity_desc" => filteredPackages.OrderByDescending(p => p.Quantity),
           "type_asc" => filteredPackages.OrderBy(p => p.PackageType.Name),
           "type_desc" => filteredPackages.OrderByDescending(p => p.PackageType.Name),
           _ => filteredPackages
       };
}
