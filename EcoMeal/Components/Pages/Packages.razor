@page "/packages"
@rendermode InteractiveServer
@using EcoMeal.Controllers
@using EcoMeal.Entities
@using EcoMeal.Entities.Enums
@inject PackageController PackageController
<h3>Packages</h3>

@if (packages is null)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3">
        <div class="col-md-5">
            <input class="form-control"
                   placeholder="Caută după nume, adresă sau descriere..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <div class="col-md-4">
            <select class="form-select" @bind="selectedType">
                <option value="">Toate tipurile</option>
                @foreach (var type in Enum.GetValues<PackageTypeEnum>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select" @bind="sortOption">
                <option value="">Fără sortare</option>
                <option value="name_asc">Nume (A→Z)</option>
                <option value="name_desc">Nume (Z→A)</option>
                <option value="price_asc">Preț (mic→mare)</option>
                <option value="price_desc">Preț (mare→mic)</option>
                <option value="quantity_asc">Cantitate (mic→mare)</option>
                <option value="quantity_desc">Cantitate (mare→mic)</option>
                <option value="type_asc">Tip (A→Z)</option>
                <option value="type_desc">Tip (Z→A)</option>
            </select>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var package in sortedPackages)
            {
                <tr>
                    <td><img src="@package.ImageUrl" alt="@package.Name" width="60" /></td>
                    <td>@package.Name</td>
                    <td>@package.Description</td>
                    <td>@package.PackageType.Name</td>
                    <td>@package.PickupStart</td>
                    <td>@package.PickupEnd</td>
                    <td>@package.Quantity</td>
                    <td>@package.Price</td>
                    <td>
                        <a href="@($"packages/update/{package.Id}")" class="btn btn-primary">Edit</a>
                        <button class="btn btn-danger" @onclick="() => ShowDeleteConfirmation(package)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (packageToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmare ștergere</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Sigur vrei să ștergi package-ul <strong>@packageToDelete.Name</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Nu</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Da, șterge</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Package>? packages;
    private Package? packageToDelete;
    private string searchTerm;
    private PackageTypeEnum? selectedType;
    private string sortOption;
    private Business? selectedBusiness;

    protected override async Task OnInitializedAsync()
    {
        packages = (await PackageController.GetAll()).Value;
    }

    private void ShowDeleteConfirmation(Package package)
    {
        packageToDelete = package;
    }

    private void CancelDelete()
    {
        packageToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (packageToDelete is null)
            return;

        await PackageController.Delete(packageToDelete.Id);
        await OnInitializedAsync();
        packageToDelete = null;
    }

    private IEnumerable<Package> filteredPackages =>
       packages is null
           ? Enumerable.Empty<Package>()
           : packages.Where(p =>
               (string.IsNullOrWhiteSpace(searchTerm) ||
                (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) 
               &&
               (selectedType is null || p.PackageTypeId == selectedType));               

    private IEnumerable<Package> sortedPackages =>
       sortOption switch
       {
           "name_asc" => filteredPackages.OrderBy(p => p.Name),
           "name_desc" => filteredPackages.OrderByDescending(p => p.Name),
           "price_asc" => filteredPackages.OrderBy(p => p.Price),
           "price_desc" => filteredPackages.OrderByDescending(p => p.Price),
           "quantity_asc" => filteredPackages.OrderBy(p => p.Quantity),
           "quantity_desc" => filteredPackages.OrderByDescending(p => p.Quantity),
           "type_asc" => filteredPackages.OrderBy(p => p.PackageType.Name),
           "type_desc" => filteredPackages.OrderByDescending(p => p.PackageType.Name),
           _ => filteredPackages
       };
}
