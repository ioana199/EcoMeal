@page "/businesses"
@using EcoMeal.Controllers
@using EcoMeal.Entities
@rendermode InteractiveServer
@inject BusinessController BusinessController

@if(businesses is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Address</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var business in businesses)
            {
                <tr>
                    <td><img src="@business.ImageUrl" alt="@business.Name" width="60" /></td>
                    <td>@business.Name</td>
                    <td>@business.Description</td>
                    <td>@business.Address</td>
                    <td>@business.BusinessType.Name</td>
                    <td>
                        <a href="@($"businesses/update/{business.Id}")" class="btn btn-primary">Edit</a>
                        <button class="btn btn-danger" @onclick="() => ShowDeleteConfirmation(business)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (businessToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmare ștergere</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Sigur vrei să ștergi business-ul <strong>@businessToDelete.Name</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Nu</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Da, șterge</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Business>? businesses;
    private Business? businessToDelete;

    protected override async Task OnInitializedAsync()
    {
        businesses = (await BusinessController.GetAll()).Value;
    }

    private void ShowDeleteConfirmation(Business business)
    {
        businessToDelete = business;
    }

    private void CancelDelete()
    {
        businessToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (businessToDelete is null)
            return;

        await BusinessController.Delete(businessToDelete.Id);
        await OnInitializedAsync();
        businessToDelete = null;
    }


}
