@page "/businesses"
@using EcoMeal.Controllers
@using EcoMeal.Entities
@using EcoMeal.Entities.Enums
@using EcoMeal.Constants
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject BusinessController BusinessController
@attribute [Authorize(Roles = AppRoles.Admin)]

@if(businesses is null)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3">
        <div class="col-md-5">
        <input class="form-control"
               placeholder="Caută după nume, adresă sau descriere..."
               @bind="searchTerm"
               @bind:event="oninput" />
        </div>

        <div class="col-md-4">
            <select class="form-select" @bind="selectedType">
                <option value="">Toate tipurile</option>
                @foreach (var type in Enum.GetValues<BusinessTypeEnum>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select" @bind="sortOption">
                <option value="">Fără sortare</option>
                <option value="name_asc">Nume (A→Z)</option>
                <option value="name_desc">Nume (Z→A)</option>
                <option value="address_asc">Adresă (A→Z)</option>
                <option value="address_desc">Adresă (Z→A)</option>
                <option value="type_asc">Tip (A→Z)</option>
                <option value="type_desc">Tip (Z→A)</option>
            </select>
        </div>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Address</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var business in sortedBusinesses)
            {
                <tr>
                    <td><img src="@business.ImageUrl" alt="@business.Name" width="60" /></td>
                    <td>@business.Name</td>
                    <td>@business.Description</td>
                    <td>@business.Address</td>
                    <td>@business.BusinessType.Name</td>
                    <td>
                        <a href="@($"businesses/update/{business.Id}")" class="btn btn-primary">Edit</a>
                        <button class="btn btn-danger" @onclick="() => ShowDeleteConfirmation(business)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!sortedBusinesses.Any())
    {
        <p><em>No businesses found.</em></p>
    }
}

@if (businessToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmare ștergere</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Sigur vrei să ștergi business-ul <strong>@businessToDelete.Name</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Nu</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Da, șterge</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Business>? businesses;
    private Business? businessToDelete;
    private string searchTerm;
    private BusinessTypeEnum? selectedType;
    private string sortOption;


    protected override async Task OnInitializedAsync()
    {
        businesses = (await BusinessController.GetAll()).Value;
    }

    private void ShowDeleteConfirmation(Business business)
    {
        businessToDelete = business;
    }

    private void CancelDelete()
    {
        businessToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (businessToDelete is null)
            return;

        await BusinessController.Delete(businessToDelete.Id);
        await OnInitializedAsync();
        businessToDelete = null;
    }

    private IEnumerable<Business> filteredBusinesses =>
        businesses is null
            ? Enumerable.Empty<Business>()
            : businesses.Where(b =>
                (string.IsNullOrWhiteSpace(searchTerm) ||
                 (b.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (b.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                 (b.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                &&
                (selectedType is null || b.BusinessTypeId == selectedType));


    private IEnumerable<Business> sortedBusinesses =>
       sortOption switch
       {
           "name_asc" => filteredBusinesses.OrderBy(b => b.Name),
           "name_desc" => filteredBusinesses.OrderByDescending(b => b.Name),
           "address_asc" => filteredBusinesses.OrderBy(b => b.Address),
           "address_desc" => filteredBusinesses.OrderByDescending(b => b.Address),
           "type_asc" => filteredBusinesses.OrderBy(b => b.BusinessType.Name),
           "type_desc" => filteredBusinesses.OrderByDescending(b => b.BusinessType.Name),
           _ => filteredBusinesses
       };
}
